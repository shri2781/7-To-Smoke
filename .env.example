# Neon connection strings — these are DIFFERENT strings, not the same one twice.
# DATABASE_URL: the pooled connection (contains "-pooler"), used at runtime
#   by the Neon serverless driver (src/server/db.ts). Must include
#   ?sslmode=require. Any extra &pgbouncer=true&connection_limit=N Neon's
#   dashboard adds is harmless but unused — the driver adapter bypasses
#   Prisma's own TCP pool entirely, so those params have nothing to tune.
# DIRECT_URL: the direct connection (no "-pooler"), used only by
#   `prisma migrate` (migrations don't go through the adapter).
#   Must include ?sslmode=require
# Get both from the Neon dashboard -> Connection Details -> toggle "Pooled connection".
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# The single shared passcode that gates every screen of the app.
ADMIN_PASSCODE="change-me"

# Secret used to sign session JWTs. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-me-too"

# Server port (Render overrides this with its own PORT at runtime).
PORT=3001

NODE_ENV=development
